NODE_ENV=development
# ─── Port assignments (this project must NOT clash with the keera project) ────
# Frontend  → 5174   (keera uses 5173)
# Backend   → 3001   (keera uses 3000)
# Postgres  → 5433   (keera uses 5432)
# Redis     → 6379
PORT=3001
DATABASE_URL=postgres://bus:bus@localhost:5433/bustracker
CORS_ORIGINS=http://localhost:5174
LOG_LEVEL=info
# bus status thresholds (seconds since last GPS fix received by the server)
STATUS_LIVE_SECONDS=15
STATUS_DELAYED_SECONDS=120
STATUS_OFFLINE_SECONDS=600
# GPS ingest validation
MAX_ACCURACY_M=100
MAX_FUTURE_SKEW_SECONDS=30
MAX_PAST_SKEW_SECONDS=300
# ETA: seconds of dwell per stop passed on the way, speed assumed before the bus has shown its own, and how far from the route line a fix may be before the bus counts as off route
ETA_DWELL_SECONDS=20
ETA_DEFAULT_SPEED_MPS=5
ROUTE_OFF_ROUTE_M=30
# Auth. JWT_SECRET is REQUIRED in production (32+ random characters, e.g. from `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
# JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# separate database used by `npm test` (never the dev DB)
TEST_DATABASE_URL=postgres://bus:bus@localhost:5433/bustracker_test

# Rate limits, per minute. Many students share one campus IP, so the per-IP cap is generous; sign-in, location posts and admin changes are limited harder.
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_LOCATION_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=120
# A trip whose driver has been silent this long is closed automatically (minutes), and GPS history is kept this many days
STALE_TRIP_MINUTES=30
JANITOR_INTERVAL_SECONDS=60
GPS_RETENTION_DAYS=90
# A fix that implies a bus moved faster than this (m/s) since the previous one is refused as a GPS glitch or spoof
MAX_JUMP_SPEED_MPS=45
# WebSocket connection caps (whole server, and per client address)
WS_MAX_CONNECTIONS=5000
WS_MAX_CONNECTIONS_PER_IP=300
# Optional: report unexpected server errors to Sentry (free tier). Leave empty to send nothing anywhere.
# SENTRY_DSN=
# RELEASE=
